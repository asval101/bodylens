# 身知 BodyLens 的 Nginx 站点配置
# 放到 /etc/nginx/sites-available/bodylens 并软链到 sites-enabled
# 把 bodylens.example.com 换成自己的域名

server {
    listen 80;
    listen [::]:80;
    server_name bodylens.example.com;

    # certbot 会自动往这里加 443 的配置，先留 80 用于签发
    root /opt/bodyledger;
    index index.html;

    # 静态文件交给 Nginx，比让 Node 读盘快，也让 Node 只管接口
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Cache-Control "no-cache" always;
    }

    # 文本压缩：不压缩的话 CSS+JS 约 85KB，压缩后约 17KB，
    # 在国际线路上这个差别直接体现在首屏快慢
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 脚本与样式走「每次校验」而不是直接命中缓存：
    # no-cache 不是"不缓存"，是"每次带 ETag 来问一句"，没改动只回 304，
    # 几百字节，改动了立刻拿到新文件——站点还在改的时候这个最合适。
    # 踩过的坑：这里原本写 expires 1h，浏览器整整一小时都不回来问，
    # 部署完刷新还是旧脚本，看着像"改了没生效"。
    # 还要注意：命中这里的请求由 Nginx 直接读盘返回，根本不经过 Node，
    # 所以 Node 里那句 Cache-Control 对静态文件是不生效的，必须在这里加。
    location ~* \.(css|js)$ {
        expires off;
        add_header Cache-Control "no-cache" always;
    }

    # 图片与字体几乎不变，长缓存直接省掉往返
    location ~* \.(svg|png|jpg|jpeg|webp|ico|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    # 解读接口：必须关掉缓冲，否则流式会一次性吐完，
    # 界面上「逐字出现」的效果就没了，这一条是踩过的坑。
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
        chunked_transfer_encoding on;
    }

    # 不对外暴露源码、内部文档与配置
    # 只放行 index.html / *.css / *.js / data/ / assets/，其余目录一律 404
    location ~ ^/(server|tests|scripts|docs|research|design-lab|artwork|\.git|\.workbuddy)(/|$) {
        deny all;
        return 404;
    }

    # 根目录的说明文档与包描述也不该被访问
    location ~* ^/[^/]*\.(md|json|sh|cjs|yml|yaml|env)$ {
        deny all;
        return 404;
    }
}
