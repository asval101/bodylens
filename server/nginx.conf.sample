# 身知 BodyLens 的 Nginx 站点配置
# 放到 /etc/nginx/sites-available/bodylens 并软链到 sites-enabled
# 把 bodylens.example.com 换成自己的域名

server {
    listen 80;
    listen [::]:80;
    server_name bodylens.example.com;

    # certbot 会自动往这里加 443 的配置，先留 80 用于签发
    root /opt/bodylens;
    index index.html;

    # 静态文件交给 Nginx，比让 Node 读盘快，也让 Node 只管接口
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # 带版本号的静态资源可以放心长缓存
    location ~* \.(css|js|svg|png|jpg|webp|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # 解读接口：必须关掉缓冲，否则流式会一次性吐完，
    # 界面上「逐字出现」的效果就没了，这一条是踩过的坑。
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
        chunked_transfer_encoding on;
    }

    # 不要把服务端配置和源码目录暴露出去
    location ~ ^/(server|tests|scripts|\.git)/ {
        deny all;
        return 404;
    }
}
